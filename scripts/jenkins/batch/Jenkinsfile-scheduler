def project_name = 'batch-source'

// Jenkins 아이템별 환경변수로 주입 (GUI "This project is parameterised")
//   BATCH_JOB_NAME : 실행할 Spring Batch Job 이름
//
// 스케줄은 Jenkins GUI에서 설정:
//   Configure(구성) > Build Triggers > 'Build periodically(주기적으로 빌드)' 체크 후 cron 표현식 입력
//
// 아이템별 권장 설정:
//   batch-scraper : BATCH_JOB_NAME=emerging-tech.scraper.job, Schedule=H H/6 * * *   (6시간마다)
//   batch-rss     : BATCH_JOB_NAME=emerging-tech.rss.job,     Schedule=H H/4 * * *   (4시간마다)
//   batch-github  : BATCH_JOB_NAME=emerging-tech.github.job,  Schedule=H 0-6 * * *   (매일 새벽 1회)
def jobName = env.BATCH_JOB_NAME

pipeline {
    agent any

    parameters {
        choice(
            name: 'SPRING_PROFILE',
            choices: ['local', 'dev', 'beta', 'prod'],
            description: 'Spring 프로파일'
        )
    }

    environment {
        BUILD_DIR = "${JENKINS_HOME}/builds"
        PROJECT_NAME = "${project_name}"
        JAR_PATH = "${JENKINS_HOME}/builds/${project_name}.jar"
        // 배치가 수집 결과를 저장할 때 호출하는 서버.
        // 주소는 client/feign/src/main/resources/application-feign-internal.yml 의
        // emerging-tech-internal-api 설정과 같아야 한다.
        EMERGING_TECH_API_URL = 'http://localhost:8082'
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    if (!jobName) {
                        error """BATCH_JOB_NAME 환경변수가 설정되지 않았습니다.

[설정 방법]
1. Jenkins 대시보드에서 이 아이템 클릭
2. 좌측 메뉴 'Configure(구성)' 클릭
3. 'This project is parameterised(이 빌드는 매개변수가 있습니다)' 체크
4. 'Add Parameter(매개변수 추가)' > 'String Parameter(문자열 매개변수)' 선택
5. Name: BATCH_JOB_NAME / Default Value: 실행할 잡 이름 입력
   (예: emerging-tech.scraper.job, emerging-tech.rss.job, emerging-tech.github.job)
"""
                    }
                    echo "Parameters validated - Job: ${jobName}"
                }
            }
        }

        stage('Validate JAR') {
            steps {
                script {
                    if (!fileExists("${env.JAR_PATH}")) {
                        error "JAR file not found: ${env.JAR_PATH}. Run CI/CD Pipeline first."
                    }
                    echo "JAR validated: ${env.JAR_PATH}"
                }
            }
        }

        stage('Validate API Server') {
            steps {
                script {
                    // 배치는 수집한 데이터를 api-emerging-tech 내부 API로 넘겨서 저장한다.
                    // 서버가 안 떠 있으면 RSS 를 다 긁어온 뒤 첫 청크를 저장하다 죽으므로,
                    // 실행 전에 미리 확인해서 "서버 없음"과 "배치 로직 오류"를 구분한다.
                    def healthUrl = "${env.EMERGING_TECH_API_URL}/actuator/health"

                    // 연결 자체가 안 되면 curl 이 상태 코드를 000 으로 찍는다.
                    // 200 이 아니어도(예: Redis 가 죽어 health 가 DOWN) 배치는 돌 수 있으므로
                    // 응답이 오기만 하면 통과시킨다.
                    def httpCode = sh(
                        returnStdout: true,
                        script: "curl -s -o /dev/null -m 5 -w '%{http_code}' ${healthUrl} || true"
                    ).trim()

                    if (httpCode == '000') {
                        error """api-emerging-tech 서버에 연결할 수 없습니다: ${healthUrl}

배치는 수집 결과를 이 서버의 내부 API로 저장하므로, 서버 없이는 실행할 수 없습니다.
서버를 먼저 띄운 뒤 이 잡을 다시 실행하세요.

  ./gradlew :api-emerging-tech:bootRun
"""
                    }

                    if (httpCode != '200') {
                        echo "api-emerging-tech 응답은 왔지만 health 가 정상이 아닙니다 (HTTP ${httpCode}). 배치는 그대로 진행합니다."
                    } else {
                        echo "API server validated: ${env.EMERGING_TECH_API_URL}"
                    }
                }
            }
        }

        stage('Execute Batch Job') {
            steps {
                withCredentials([
                    string(credentialsId: 'github-token-batch-source', variable: 'GITHUB_TOKEN'),
                    string(credentialsId: 'mongodb-atlas-connection-string', variable: 'MONGODB_ATLAS_CONNECTION_STRING')
                ]) {
                    script {
                        echo "Executing: ${jobName} with profile ${params.SPRING_PROFILE}"

                        def exitCode = sh(
                            returnStatus: true,
                            script: """
                                java -Dspring.profiles.active=${params.SPRING_PROFILE} \
                                    -jar ${env.JAR_PATH} \
                                    --job.name=${jobName}
                            """
                        )

                        env.batchExitCode = "${exitCode}"

                        if (exitCode != 0) {
                            error "Batch Job failed with exit code: ${exitCode}"
                        }
                    }
                }
            }
        }

        stage('Health Check') {
            steps {
                echo "Batch Job completed successfully."
                echo "Job: ${jobName}"
                echo "Profile: ${params.SPRING_PROFILE}"
                echo "Exit Code: ${env.batchExitCode}"
            }
        }
    }

    post {
        failure {
            echo "=== BATCH JOB FAILURE ==="
            echo "Job: ${jobName}"
            echo "Profile: ${params.SPRING_PROFILE}"
            echo "Exit Code: ${env.batchExitCode}"
            echo "Check console output for detailed error logs."
        }
    }
}
