                </mxCell>
                <mxCell id="lg1d" value="&lt;div&gt;&lt;b&gt;Client reaches the ALB&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Client / API consumer sends HTTPS requests to the internet-facing ALB on port 443. HTTP on port 80 is redirected to 443.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="lg1" vertex="1">
                    <mxGeometry x="52" width="548" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="lg2" value="" style="group;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry y="88" width="600" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="lg2b" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="lg2" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="lg2d" value="&lt;div&gt;&lt;b&gt;ALB routes by path&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;The ALB forwards each request to the matching ECS Fargate service by listener path (e.g. /auth/* to api-auth).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="lg2" vertex="1">
                    <mxGeometry x="52" width="548" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="lg3" value="" style="group;fontFamily=Helvetica;" parent="legend-container" vertex="1">
                    <mxGeometry y="176" width="600" height="78" as="geometry"/>
                </mxCell>
