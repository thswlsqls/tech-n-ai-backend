                <mxCell id="s6-d" value="&lt;div&gt;&lt;b&gt;대시보드&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Overview 대시보드(dashboard_enabled=true): 텍스트 1개 + 서비스별 CPU 라인 위젯 6개.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="s6-g" vertex="1">
                    <mxGeometry x="52" width="510" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="off-note" value="회색 점선 = 설계됨·미가동: ADOT(분산추적→X-Ray)·FireLens(PII 마스킹) 사이드카가 전 환경 off. 트레이스 미수집, 로그는 마스킹 없이 적재." style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontStyle=2;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#5A6B6D,#C7D2D4);" parent="legend-container" vertex="1">
