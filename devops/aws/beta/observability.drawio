                    <mxGeometry y="74" width="560" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="s2-b" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="s2-g" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s2-d" value="&lt;div&gt;&lt;b&gt;로그 적재&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;컨테이너 stdout 을 awslogs 드라이버로 서비스별 CloudWatch Log Group 에 적재. 보존 30일, KMS(logs 키) 암호화.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="s2-g" vertex="1">
                    <mxGeometry x="52" width="510" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="s3-g" value="" style="group;fontFamily=Helvetica;" parent="legend-container" connectable="0" vertex="1">
                    <mxGeometry y="148" width="560" height="64" as="geometry"/>
