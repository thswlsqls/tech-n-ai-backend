                <mxCell id="s3-b" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" parent="s3-g" vertex="1">
                    <mxGeometry y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="s3-d" value="&lt;div&gt;&lt;b&gt;표준 알람 평가&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;서비스 6종 × 3종(CPU&gt;80%, MEM&gt;85%, RunningTaskCount&lt;1) = 18개. 3분(60초×3). running 알람은 결측치를 위반으로 처리.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="s3-g" vertex="1">
                    <mxGeometry x="52" width="510" height="64" as="geometry"/>
                </mxCell>
