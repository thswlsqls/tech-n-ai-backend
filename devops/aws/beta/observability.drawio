                <mxCell id="line-styles" value="&lt;b&gt;선 표기&lt;/b&gt;&lt;div&gt;━ 실선(검정): 가동 중인 데이터 흐름&lt;/div&gt;&lt;div&gt;- - 빨강 점선: KMS 암호화 관계&lt;/div&gt;&lt;div&gt;- - 회색 점선: 미가동(off) 요소&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#000000,#FFFFFF);" parent="legend-container" vertex="1">
                    <mxGeometry y="504" width="560" height="90" as="geometry"/>
